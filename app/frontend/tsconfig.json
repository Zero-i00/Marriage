{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "/tmp/claude-1000/-home-artem-----------Projects-Marriage/f08338eb-6e7d-42f7-860c-194a627e017c/scratchpad/next-verify-dist/types/**/*.ts",
    "/tmp/claude-1000/-home-artem-----------Projects-Marriage/f08338eb-6e7d-42f7-860c-194a627e017c/scratchpad/next-verify-dist/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
